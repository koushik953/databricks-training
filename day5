1-select s.student_name,c.course_name
from students s
left join enrollments e on s.student_id=e.student_id
left  join courses c on e.course_id=c.course_id
  2-select c.course_name
from students s
right join enrollments e on s.student_id=e.student_id
right  join courses c on e.course_id=c.course_id
 group by c.course_name
having count(s.student_id)=0;
3-select c.course_name,i.instructor_name
from courses c
left join instructors i on c.instructor_id=i.instructor_id;
4-select c.course_name
from courses c
left join instructors i on c.instructor_id=i.instructor_id
where c.instructor_id is null;
5-select *
from students s
right join enrollments e on s.student_id=e.student_id;
6-select *
from students s
left join enrollments e on s.student_id=e.student_id
where e.course_id is null;
7-select *
from students s
full outer join enrollments e on s.student_id=e.student_id;
8-select c.course_name
from courses c
left join instructors i on c.instructor_id=i.instructor_id
left join enrollments e on c.course_id=e.course_id
where i.instructor_id is null;
9-select i.instructor_name,c.course_name
from  instructors i
full outer join courses c on c.instructor_id=i.instructor_id
order by c.instructor_id;
10-select i.instructor_name,c.course_name,s.student_name
from  instructors i
full outer join courses c on c.instructor_id=i.instructor_id
full outer join enrollments e on e.course_id=c.course_id
full outer join students s on s.student_id=e.student_id;
Bonus challenge-select c.course_name,s.student_name
from courses c
full outer join enrollments e on e.course_id=c.course_id
full outer join students s on s.student_id=e.student_id;
